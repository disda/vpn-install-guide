{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vpn-install-guide",
  "account_id": "bb4258f92a4c1b999445855a70fd67e3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "guide.wepic.top",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vpn-install-guide",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "d8fe4589bb484a3fb0d4e4c3668e5578",
    },
  ],
  "d1_databases": [
    {
      "binding": "TEXT_SHARE_DB",
      "database_name": "vpn-guide-text-shares",
      "database_id": "a87272ae-b3eb-4572-8de7-c20582068ca4",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "TEXT_SHARE_RATE_LIMITER",
      "namespace_id": "310031",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
